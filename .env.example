VITE_BASE44_APP_ID=your_app_id_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# =========================================================
# Supabase (auth + database — Phase 1+)
# =========================================================

# PUBLIC (browser) — anon key is safe to expose; RLS enforces isolation
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# SERVER-ONLY — service_role key bypasses RLS, NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =========================================================
# QuickBooks Online API (get credentials from developer.intuit.com)
# =========================================================

# PUBLIC vars (VITE_ prefix - bundled into browser code)
VITE_QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
VITE_QUICKBOOKS_REDIRECT_URI=http://localhost:5173/Settings?tab=quickbooks
VITE_QUICKBOOKS_ENVIRONMENT=sandbox

# SERVER-ONLY vars (NO VITE_ prefix - stay on the server)
# These are used by /api/quickbooks/token.js - CLIENT_SECRET is NEVER exposed to the browser.
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
QUICKBOOKS_REDIRECT_URI=http://localhost:5173/Settings?tab=quickbooks
